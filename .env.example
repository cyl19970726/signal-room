SIGNAL_ROOM_DATABASE_PATH=.signal-room/signal-room.sqlite
# Must remain outside the repository for real collected artifacts.
SIGNAL_ROOM_ARTIFACT_ROOT=/absolute/path/outside/signal-room/repository
# Required local ego-browser configuration. Keep real values only in ignored .env.
SIGNAL_ROOM_EGO_PROFILE=
SIGNAL_ROOM_EGO_TASK_SPACE=
# Required explicit local Web origin, for example http://127.0.0.1:4318.
SIGNAL_ROOM_WEB_ORIGIN=
SIGNAL_ROOM_API_PORT=4317
